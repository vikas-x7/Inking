# Compiler service environment.
#
# Docker/Render deployments run the embedded TeX toolchain in-process
# (LATEX_EXECUTOR=native) - no docker-in-docker required. Render injects PORT
# at runtime, so the container default of 10000 is used here.
PORT=10000
NODE_ENV=production
COMPILER_INTERNAL_TOKEN=replace-with-a-long-random-secret

# Executor strategy:
#   native -> spawn pdflatex/xelatex/lualatex directly (recommended for Docker)
#   none   -> latexrun pipeline (local development default)
#   docker -> one-shot hardened job containers (requires a Docker host and
#             LATEX_EXECUTOR_IMAGE below; NOT available inside this image)
LATEX_EXECUTOR=native
# LATEX_EXECUTOR_IMAGE=latex-online:biblatex-fixed

# Upper bound on engine passes; compilations stop earlier when references settle.
# LATEX_MAX_PASSES=3

# Optional tuning (the server-side defaults are safe for most workloads):
# LATEX_COMPILE_TIMEOUT_MS=60000
# LATEX_MAX_CONCURRENT_COMPILATIONS=4