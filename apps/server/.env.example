# ═══════════════════════════════════════════════════════════════
#  Backend (Hono) environment — set these on Render
# ═══════════════════════════════════════════════════════════════

# ── API_URL ───────────────────────────────────────────────────
# THIS backend's own public URL (the Render web service URL).
# Used for:
#   - the port the server binds to ($PORT on Render wins first)
# Integration note: OAuth callbacks do NOT point here — they go through the
# frontend proxy at <FRONTEND_URL>/api/auth/... so auth cookies stay
# same-origin on the Vercel domain.
# Local dev:
API_URL="http://localhost:3001"
# Production on Render:
# API_URL="https://inking-1.onrender.com"

# ── FRONTEND_URL ──────────────────────────────────────────────
# The frontend's public URL (your Vercel deployment domain).
# Used for:
#   - the OAuth callback → <FRONTEND_URL>/api/auth/google/callback
#     (register THIS exact URL in Google Console as the redirect URI)
#   - the GitHub callback → <FRONTEND_URL>/api/auth/github/callback
#   - the post-login redirect → <FRONTEND_URL>/editor/<documentId>
# Local dev:
FRONTEND_URL="http://localhost:3000"
# Production on Vercel:
# FRONTEND_URL="https://inking-web.vercel.app"

ACCESS_JWT_SECRET="replace-with-at-least-32-random-characters"
REFRESH_JWT_SECRET="replace-with-another-at-least-32-random-characters"

# ── Google OAuth (console.cloud.google.com → APIs & Services) ─
# Authorized redirect URI in Google Console:
#   <FRONTEND_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── GitHub OAuth (github.com/settings/developers) ────────────
# Authorization callback URL in the GitHub OAuth app:
#   <FRONTEND_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

LATEX_ONLINE_URL="https://latexonline.cc"